# App
APP__ALLOWED_ORIGINS='["http://localhost:8000"]'

# Database
DB__DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/my_database
DB__USER=""
DB__PASSWORD=""
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=5
DB__POOL_PRE_PING=true
DB__POOL_TIMEOUT=30

# JWT
JWT__SECRET=change-me-to-a-secure-random-secret-key
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15

# SMTP
SMTP__FROM_EMAIL=noreply@example.com
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__USER=smtp_username
SMTP__PASSWORD=smtp_password
SMTP__USE_TLS=false
