# App
APP__BASE_URL=http://localhost:8000
APP__ALLOWED_ORIGINS='["http://localhost:8000"]'

# Database
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=innotech
DB__DSN=postgresql+asyncpg://postgres:postgres@database:5432/innotech
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=5
DB__POOL_PRE_PING=true
DB__POOL_TIMEOUT=30

# JWT
JWT__SECRET=change-me-to-a-secure-random-secret-key
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15

# SMTP (Mailpit из compose, веб на http://localhost:8025)
SMTP__FROM_EMAIL=noreply@innotech.local
SMTP__HOST=mailpit
SMTP__PORT=1025
SMTP__USE_TLS=false
